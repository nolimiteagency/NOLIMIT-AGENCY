# Copier en .env.local pour tester en local (npm start). En production : Vercel → Settings → Environment Variables.
# Ne jamais mettre de vraie clé ou de vrai mot de passe dans un fichier versionné.

# Option 1 (sans domaine) — envoi depuis la boîte Gmail de l'agence
GMAIL_USER=nolimite.agency@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
QUOTE_TO=nolimite.agency@gmail.com

# Option 2 (avec domaine vérifié) — Resend, utilisé si GMAIL_* n'est pas défini
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# QUOTE_FROM=NO LIMIT <devis@nolimitdigital.agency>
